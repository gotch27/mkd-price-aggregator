APP_ENV_FILE=.env.local
# Source downloads have a separate connection timeout and total request deadline.
NEXTSIGNAL_HTTP__CONNECT_TIMEOUT_MS=30000
NEXTSIGNAL_HTTP__TIMEOUT_MS=60000
# Used by Docker Compose. Explicit values; replace markers or run npm run setup.
POSTGRES_USER=catalog
POSTGRES_DB=catalog
POSTGRES_PASSWORD=__DATABASE_PASSWORD__
POSTGRES_PORT=55432
WEB_PORT=3000
NEXTSIGNAL_DATABASE__URL=postgresql://catalog:__DATABASE_PASSWORD__@localhost:55432/catalog
DATABASE_DOCKER_URL=postgresql://catalog:__DATABASE_PASSWORD__@postgres:5432/catalog
NEXTSIGNAL_AUTH__PASSWORD=__ADMIN_PASSWORD__
NEXTSIGNAL_AUTH__SESSION_SECRET=__SESSION_SECRET__
# Set the Vercel Gateway key privately, then grant AI permission in Settings.
# NEXTSIGNAL_MATCHING__GATEWAY__API_KEY=your-vercel-ai-gateway-key

# Explicit PostgreSQL server resources for the full branch catalog.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=64
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPUS=1.5
WEB_MEMORY_LIMIT=512m
WEB_CPUS=1.0
WORKER_MEMORY_LIMIT=768m
WORKER_CPUS=1.0
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_CPUS=1.0
NEXTSIGNAL_HTTP__RESPONSE_IDLE_TIMEOUT_MS=20000
NEXTSIGNAL_HTTP__HOST_TIMEOUT_MS={"kam.com.mk":90000,"ramstore.com.mk":60000,"stokomak.proverkanaceni.mk":120000,"spar.mk":60000,"api.prod.spar.mk":60000,"zito.proverkanaceni.mk":60000,"pricelist.vero.com.mk":60000,"ceni.zur.mk":60000,"dim.marketceni.mk":60000,"www.reptilmarketi.mk":60000,"cms.reptilmarketi.mk":60000,"marketonline.mk":60000}
NEXTSIGNAL_HTTP__COOLDOWN__FAILURE_THRESHOLD=3
NEXTSIGNAL_HTTP__COOLDOWN__BASE_MS=300000
NEXTSIGNAL_HTTP__COOLDOWN__MAX_MS=1800000
NEXTSIGNAL_MATCHING__RULES_VERSION=cross-store-v7-dimensional-packs
NEXTSIGNAL_MATCHING__LOCAL__VERSION=exact-names-v3
NEXTSIGNAL_QUEUE__DISPATCH_LEASE_SECONDS=120
NEXTSIGNAL_INGESTION__PAGES_PER_TURN=25
NEXTSIGNAL_INGESTION__TURN_DURATION_MS=30000
NEXTSIGNAL_QUEUE__POLL_SECONDS=1
NEXTSIGNAL_SOURCES__STOKOMAK__PAGE_SIZE=20
NEXTSIGNAL_SOURCES__ZITO__PAGE_SIZE=100
NEXTSIGNAL_QUEUE__CONCURRENCY={"catalog.download":4,"catalog.publish":1,"tasks.job":1}
NEXTSIGNAL_INGESTION__PARALLEL_PUBLICATIONS=1
NEXTSIGNAL_INGESTION__MAX_READY_CATALOGS=4
NEXTSIGNAL_DASHBOARD__STATS_REFRESH_MS=60000

# Bounded local maintenance operations; never a grant to run external work.
NEXTSIGNAL_MAINTENANCE__BATCH_SIZE=10000
