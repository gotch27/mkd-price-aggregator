      "consecutive_failure_limit": 3,
      "cooldown_initial_seconds": 60,
      "cooldown_max_seconds": 900,
      "cooldown_probe_lease_seconds": 120
    },
    "category_mappings_version": "store-categories-v1",
    "category_mappings": [
      {
        "retailer": "stokomak",
        "pattern": "^svezho ovos[hj]*je$",
        "family": "fruit"
      },
      {
        "retailer": "stokomak",
        "pattern": "^svezh zelenchuk$",
        "family": "vegetables"
      },
      {
        "retailer": "reptil",
        "pattern": "jogurt|mleko|kashkaval|sirenje",
        "family": "dairy"
      },
      {
        "retailer": "vero",
        "pattern": "(?:^| )alkoholni pijaloci(?:$| )",
        "family": "alcohol"
      },
      {
        "retailer": "ramstore",
        "pattern": "^oriz$",
        "family": "other_food"
      },
      {
        "retailer": "vero",
        "pattern": "^bezalkoholni pijaloci(?: |$)",
        "family": "soft_drinks"
      },
      {
        "retailer": "ramstore",
        "pattern": "^negaziran sok$",
        "family": "soft_drinks"
      }
    ],
    "evaluation": {
      "sample_per_store": 10,
      "holdout_divisor": 3
    },
    "candidate_weights": {
      "barcode": 10,
      "signature": 5,
      "brand": 1,
      "quantity": 0.5,
      "category": 0.1
    },
    "manual": {
      "candidate_limit": 5,
      "group_member_limit": 100,
      "search_min_length": 2,
      "max_note_length": 500
