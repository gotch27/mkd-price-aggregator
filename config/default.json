{
  "app": {
    "name": "MKD Catalog",
    "timezone": "Europe/Skopje"
  },
  "database": {
    "pool_size": 28,
    "connection_timeout_ms": 10000,
    "idle_timeout_ms": 30000
  },
  "auth": {
    "username": "admin",
    "session_hours": 12,
    "secure_cookie": false,
    "login_window_ms": 900000,
    "login_attempts": 10,
    "login_client_header": "cf-connecting-ip",
    "allowed_origins": ["http://localhost:3000", "http://127.0.0.1:3000"]
  },
  "scheduler": {
    "tick_ms": 60000,
    "run_on_start": true,
    "tick_cron": "* * * * *"
  },
  "queue": {
    "concurrency": {
      "catalog.download": 4,
      "catalog.publish": 1,
      "tasks.job": 1
    },
    "poll_seconds": 1,
    "retry_limit": 5,
    "retry_delay_seconds": 60,
    "expire_seconds": 14400,
    "retention_seconds": 604800,
    "dispatch_batch": 100,
    "retry_backoff": true,
    "heartbeat_seconds": 30,
    "heartbeat_refresh_seconds": 10,
    "stop_ms": 30000,
    "scheduler_concurrency": 1,
    "database_pool_size": 4,
    "dispatch_lease_seconds": 120
  },
  "http": {
    "timeout_ms": 60000,
    "connect_timeout_ms": 30000,
    "max_pages": 10000,
    "max_bytes": 52428800,
    "user_agent": "MKDCatalog/0.1 (+private price catalog research)",
    "host_intervals_ms": {
      "kam.com.mk": 1000,
      "ramstore.com.mk": 1000,
      "stokomak.proverkanaceni.mk": 500,
      "spar.mk": 1000,
      "api.prod.spar.mk": 200,
      "zito.proverkanaceni.mk": 500,
      "pricelist.vero.com.mk": 1000,
      "ceni.zur.mk": 1000,
      "dim.marketceni.mk": 1000,
      "www.reptilmarketi.mk": 1000,
      "cms.reptilmarketi.mk": 1000,
      "marketonline.mk": 1000
    },
    "response_idle_timeout_ms": 20000,
    "host_timeout_ms": {
      "kam.com.mk": 90000,
      "ramstore.com.mk": 60000,
      "stokomak.proverkanaceni.mk": 120000,
      "spar.mk": 60000,
      "api.prod.spar.mk": 60000,
      "zito.proverkanaceni.mk": 60000,
      "pricelist.vero.com.mk": 60000,
      "ceni.zur.mk": 60000,
      "dim.marketceni.mk": 60000,
      "www.reptilmarketi.mk": 60000,
      "cms.reptilmarketi.mk": 60000,
      "marketonline.mk": 60000
    },
    "cooldown": {
      "failure_threshold": 3,
      "base_ms": 300000,
      "max_ms": 1800000
    }
  },
  "ingestion": {
    "reduction_ratio": 0.7,
    "artifact_hours": 24,
    "staging_hours": 48,
    "invalid_price_policy": "preserve_unknown",
    "freshness_hours": 168,
    "pages_per_turn": 25,
    "turn_duration_ms": 30000,
    "parallel_publications": 1,
    "max_ready_catalogs": 4
  },
  "matching": {
    "batch_size": 50,
    "candidate_limit": 20,
    "threshold": 0.75,
    "prompt_version": "category-first-v1",
    "candidate_similarity": 0.3,
    "local": {
      "enabled": true,
      "version": "exact-names-v3"
    },
    "candidate_batch_size": 5,
    "category_threshold": 0.8,
    "lease_seconds": 300,
    "rules_version": "cross-store-v7-dimensional-packs",
    "gateway": {
      "enabled": false,
      "api_key": "disabled",
      "base_url": "https://ai-gateway.vercel.sh/v1/",
      "decision_endpoint": "evaluate",
      "extraction_endpoint": "chat/completions",
      "decision_model": "perplexity/pplx-decider-v1.2",
      "extraction_model": "alibaba/qwen3.7-flash",
      "decision_input_per_million": 0.02,
      "decision_output_per_million": 0,
      "extraction_input_per_million": 0.03,
      "extraction_output_per_million": 0.13,
      "initial_budget_usd": 25,
      "monthly_budget_usd": 2,
      "evaluation_budget_usd": 0.25,
      "timeout_ms": 45000,
      "max_input_bytes": 32000,
      "token_overhead_allowance": 2048,
      "max_output_tokens": 512,
      "max_requests_per_campaign": 3000000,
      "max_requests_per_month": 50000,
      "reasoning_enabled": false,
      "retry_attempts": 3,
      "retry_delay_ms": 1000,
      "retry_max_delay_ms": 5000,
      "consecutive_failure_limit": 3,
      "cooldown_initial_seconds": 60,
      "cooldown_max_seconds": 900,
      "cooldown_probe_lease_seconds": 120
    },
    "category_mappings_version": "store-categories-v1",
    "category_mappings": [
      {
        "retailer": "stokomak",
        "pattern": "^svezho ovos[hj]*je$",
        "family": "fruit"
      },
      {
        "retailer": "stokomak",
        "pattern": "^svezh zelenchuk$",
        "family": "vegetables"
      },
      {
        "retailer": "reptil",
        "pattern": "jogurt|mleko|kashkaval|sirenje",
        "family": "dairy"
      },
      {
        "retailer": "vero",
        "pattern": "(?:^| )alkoholni pijaloci(?:$| )",
        "family": "alcohol"
      },
      {
        "retailer": "ramstore",
        "pattern": "^oriz$",
        "family": "other_food"
      },
      {
        "retailer": "vero",
        "pattern": "^bezalkoholni pijaloci(?: |$)",
        "family": "soft_drinks"
      },
      {
        "retailer": "ramstore",
        "pattern": "^negaziran sok$",
        "family": "soft_drinks"
      }
    ],
    "evaluation": {
      "sample_per_store": 10,
      "holdout_divisor": 3
    },
    "candidate_weights": {
      "barcode": 10,
      "signature": 5,
      "brand": 1,
      "quantity": 0.5,
      "category": 0.1
    },
    "manual": {
      "candidate_limit": 5,
      "group_member_limit": 100,
      "search_min_length": 2,
      "max_note_length": 500
    },
    "ai_categories": [],
    "prompts": {
      "root": "prompts",
      "classification": "classification.md",
      "comparison": "matching.md",
      "clarification": "clarification.md",
      "categories": "categories.json",
      "comparison_answers": "matching-answers.json",
      "stores": {
        "spar": "stores/spar.md",
        "dim": "stores/dim.md",
        "reptil": "stores/reptil.md",
        "zur": "stores/zur.md",
        "stokomak": "stores/stokomak.md",
        "vero": "stores/vero.md",
        "kam": "stores/kam.md",
        "ramstore": "stores/ramstore.md",
        "zito": "stores/zito.md"
      },
      "families": {
        "fruit": "families/fruit.md",
        "vegetables": "families/vegetables.md",
        "dairy": "families/dairy.md",
        "alcohol": "families/alcohol.md",
        "soft_drinks": "families/soft_drinks.md",
        "other_food": "families/other_food.md",
        "baby_food": "families/baby_food.md",
        "baby_care": "families/baby_care.md",
        "personal_care": "families/personal_care.md",
        "cleaning": "families/cleaning.md",
        "automotive": "families/automotive.md",
        "clothing_accessories": "families/clothing_accessories.md",
        "pet": "families/pet.md",
        "household": "families/household.md",
        "other": "families/other.md",
        "unknown": "families/unknown.md"
      },
      "comparison_question": "matching-question.md"
    }
  },
  "logging": {
    "level": "info",
    "spool_dir": ".data/log-spool",
    "operational_days": 90,
    "debug_days": 7,
    "replay_batch": 100
  },
  "dashboard": {
    "page_size": 30,
    "max_page_size": 100,
    "refresh_ms": 60000,
    "search_debounce_ms": 350,
    "auto_refresh_views": ["summary", "runs", "logs"],
    "product_name_quality": "named",
    "product_availability": "available",
    "summary_cache_ms": 60000,
    "stats_refresh_ms": 60000
  },
  "sources": {
    "kam": {
      "enabled": true,
      "name": "KAM",
      "url": "https://kam.com.mk/ceni-vo-marketi.nspx",
      "api_url": "https://kam.com.mk/ShopsWeb/LoadShopList",
      "action": null,
      "notice": null,
      "page_size": 500,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "ramstore": {
      "enabled": true,
      "name": "Ramstore",
      "url": "https://ramstore.com.mk/marketi/",
      "api_url": null,
      "action": null,
      "notice": null,
      "page_size": 500,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "stokomak": {
      "enabled": true,
      "name": "Stokomak",
      "url": "https://stokomak.proverkanaceni.mk/",
      "api_url": null,
      "action": null,
      "notice": "The published update label advances with page rendering; it is retained as reported and is not a stable snapshot version.",
      "page_size": 20,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "observed"
    },
    "spar": {
      "enabled": true,
      "name": "SPAR",
      "url": "https://spar.mk/pricelist",
      "api_url": "https://api.prod.spar.mk/api/pricelists-web/",
      "action": null,
      "notice": "The published API repeats some article codes, including different prices for the same code. Every row is retained; repeated identities are flagged ambiguous and excluded from automatic linking.",
      "page_size": 500,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "zito": {
      "enabled": true,
      "name": "Žito",
      "url": "https://zito.proverkanaceni.mk/",
      "api_url": null,
      "action": null,
      "notice": "The published update label advances with page rendering; it is retained as reported and is not a stable snapshot version.",
      "page_size": 100,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "observed"
    },
    "vero": {
      "enabled": true,
      "name": "Vero",
      "url": "https://pricelist.vero.com.mk/",
      "api_url": null,
      "action": null,
      "notice": null,
      "page_size": 500,
      "identity_policy": "occurrence",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "zur": {
      "enabled": true,
      "name": "Žur",
      "url": "https://ceni.zur.mk/",
      "api_url": "https://ceni.zur.mk/wp-admin/admin-ajax.php",
      "action": "load_prices_data",
      "notice": null,
      "page_size": 20000,
      "identity_policy": "strict",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "dim": {
      "enabled": true,
      "name": "Dim",
      "url": "https://dim.marketceni.mk/",
      "api_url": "https://ceni.zur.mk/wp-admin/admin-ajax.php",
      "action": "load_dimceni_prices_data",
      "notice": null,
      "page_size": 20000,
      "identity_policy": "strict",
      "catalog_api_url": null,
      "timestamp_policy": "snapshot"
    },
    "reptil": {
      "enabled": true,
      "name": "Reptil",
      "url": "https://www.reptilmarketi.mk/mk/pricelists",
      "api_url": "https://cms.reptilmarketi.mk/wp-json/wp/v2/pages/8",
      "action": null,
      "notice": "Published reuse-with-consent notice; current branch links point to the same webshop. Branch pricing unverified.",
      "page_size": 100,
      "identity_policy": "strict",
      "catalog_api_url": "https://marketonline.mk/wp-json/wc/store/v1/products",
      "timestamp_policy": "snapshot"
    }
  },
  "worker": {
    "heartbeat_max_age_ms": 180000,
    "heartbeat_file": ".data/worker-heartbeat"
  },
  "agent_review": {
    "default_products": 50,
    "default_include_previously_skipped": false,
    "max_products": 500,
    "batch_size": 20,
    "results_page_size": 10,
    "refresh_ms": 3000,
    "instructions_file": "agent-category-review.md"
  },
  "product_details": {
    "value_max_length": 200,
    "note_max_length": 1000,
    "history_limit": 50
  },
  "tasks": {
    "defaults": {
      "paused": false,
      "imports": "manual",
      "categorization": "manual",
      "matching": "manual",
      "ai_enabled": false,
      "clarification_enabled": false,
      "cron": "0 12 * * 1",
      "scheduled_stores": [],
      "catch_up": false,
      "ai_categories": [],
      "category_threshold": 0.8,
      "match_threshold": 0.75,
      "initial_budget_usd": 25,
      "monthly_budget_usd": 2,
      "task_budget_usd": 0.1,
      "task_request_limit": 500,
      "default_product_limit": 50,
      "candidate_limit": 20,
      "candidate_batch_size": 5,
      "batch_size": 50,
      "parallel_imports": 2,
      "per_store_downloads": 2
    }
  },
  "maintenance": {
    "batch_size": 10000
  },
  "llm_review": {
    "instructions_file": "llm-category-review.md",
    "categories_file": "category-review-definitions.json",
    "max_output_tokens": 256,
    "reasoning_enabled": false
  }
}
