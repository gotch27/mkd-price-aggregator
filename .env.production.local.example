APP_ENV_FILE=.env.production.local
# Source downloads have a separate connection timeout and total request deadline.
NEXTSIGNAL_HTTP__CONNECT_TIMEOUT_MS=30000
NEXTSIGNAL_HTTP__TIMEOUT_MS=60000
# Used by Docker Compose. Explicit values; replace markers or run npm run setup.
POSTGRES_USER=catalog
POSTGRES_DB=catalog
POSTGRES_PASSWORD=__DATABASE_PASSWORD__
POSTGRES_PORT=55432
WEB_PORT=3000
NEXTSIGNAL_DATABASE__URL=postgresql://catalog:__DATABASE_PASSWORD__@localhost:55432/catalog
DATABASE_DOCKER_URL=postgresql://catalog:__DATABASE_PASSWORD__@postgres:5432/catalog
NEXTSIGNAL_AUTH__PASSWORD=__ADMIN_PASSWORD__
NEXTSIGNAL_AUTH__SESSION_SECRET=__SESSION_SECRET__
# Keep deployment defaults quiet until tasks are explicitly reviewed.
NEXTSIGNAL_MATCHING__GATEWAY__ENABLED=false
# Set the key privately. Tasks UI permissions govern reviewed tasks; these
# deployment defaults keep standalone matching/evaluation calls disabled.
# NEXTSIGNAL_MATCHING__GATEWAY__API_KEY=your-vercel-ai-gateway-key
NEXTSIGNAL_MATCHING__GATEWAY__INITIAL_BUDGET_USD=25
NEXTSIGNAL_MATCHING__GATEWAY__MONTHLY_BUDGET_USD=2

NEXTSIGNAL_AUTH__SECURE_COOKIE=true

# Explicit PostgreSQL server resources for the full branch catalog.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=64
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPUS=1.5
WEB_MEMORY_LIMIT=512m
WEB_CPUS=1.0
WORKER_MEMORY_LIMIT=768m
WORKER_CPUS=1.0
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_CPUS=1.0

# Bounded, human-confirmed product connections; these make no AI calls.
NEXTSIGNAL_MATCHING__MANUAL__CANDIDATE_LIMIT=5
NEXTSIGNAL_MATCHING__MANUAL__GROUP_MEMBER_LIMIT=100
NEXTSIGNAL_MATCHING__MANUAL__SEARCH_MIN_LENGTH=2
NEXTSIGNAL_MATCHING__MANUAL__MAX_NOTE_LENGTH=500
NEXTSIGNAL_MATCHING__THRESHOLD=0.75
NEXTSIGNAL_MATCHING__AI_CATEGORIES=[]
NEXTSIGNAL_MATCHING__RULES_VERSION=cross-store-v7-dimensional-packs
NEXTSIGNAL_MATCHING__PROMPT_VERSION=category-first-v1
NEXTSIGNAL_MATCHING__PROMPTS={"root":"prompts","classification":"classification.md","comparison":"matching.md","clarification":"clarification.md","categories":"categories.json","comparison_answers":"matching-answers.json","stores":{"spar":"stores/spar.md","dim":"stores/dim.md","reptil":"stores/reptil.md","zur":"stores/zur.md","stokomak":"stores/stokomak.md","vero":"stores/vero.md","kam":"stores/kam.md","ramstore":"stores/ramstore.md","zito":"stores/zito.md"},"families":{"fruit":"families/fruit.md","vegetables":"families/vegetables.md","dairy":"families/dairy.md","alcohol":"families/alcohol.md","soft_drinks":"families/soft_drinks.md","other_food":"families/other_food.md","baby_food":"families/baby_food.md","baby_care":"families/baby_care.md","personal_care":"families/personal_care.md","cleaning":"families/cleaning.md","automotive":"families/automotive.md","clothing_accessories":"families/clothing_accessories.md","pet":"families/pet.md","household":"families/household.md","other":"families/other.md","unknown":"families/unknown.md"},"comparison_question":"matching-question.md"}
NEXTSIGNAL_PRODUCT_DETAILS='{"value_max_length":200,"note_max_length":1000,"history_limit":50}'
NEXTSIGNAL_TASKS__DEFAULTS={"paused":false,"imports":"manual","categorization":"manual","matching":"manual","ai_enabled":false,"clarification_enabled":false,"cron":"0 12 * * 1","scheduled_stores":[],"catch_up":false,"ai_categories":[],"category_threshold":0.8,"match_threshold":0.75,"initial_budget_usd":25,"monthly_budget_usd":2,"task_budget_usd":0.1,"task_request_limit":500,"default_product_limit":50,"candidate_limit":20,"candidate_batch_size":5,"batch_size":50,"parallel_imports":2,"per_store_downloads":2,"counterpart_limit":50,"counterparts_per_product":5}
NEXTSIGNAL_HTTP__RESPONSE_IDLE_TIMEOUT_MS=20000
NEXTSIGNAL_HTTP__HOST_TIMEOUT_MS={"kam.com.mk":90000,"ramstore.com.mk":60000,"stokomak.proverkanaceni.mk":120000,"spar.mk":60000,"api.prod.spar.mk":60000,"zito.proverkanaceni.mk":60000,"pricelist.vero.com.mk":60000,"ceni.zur.mk":60000,"dim.marketceni.mk":60000,"www.reptilmarketi.mk":60000,"cms.reptilmarketi.mk":60000,"marketonline.mk":60000}
NEXTSIGNAL_HTTP__COOLDOWN__FAILURE_THRESHOLD=3
NEXTSIGNAL_HTTP__COOLDOWN__BASE_MS=300000
NEXTSIGNAL_HTTP__COOLDOWN__MAX_MS=1800000
NEXTSIGNAL_MATCHING__LOCAL__VERSION=exact-names-v3
NEXTSIGNAL_QUEUE__DISPATCH_LEASE_SECONDS=120
NEXTSIGNAL_INGESTION__PAGES_PER_TURN=25
NEXTSIGNAL_INGESTION__TURN_DURATION_MS=30000
NEXTSIGNAL_QUEUE__POLL_SECONDS=1
NEXTSIGNAL_SOURCES__STOKOMAK__PAGE_SIZE=20
NEXTSIGNAL_SOURCES__ZITO__PAGE_SIZE=100
NEXTSIGNAL_QUEUE__CONCURRENCY={"catalog.download":4,"catalog.publish":1,"tasks.job":1}
NEXTSIGNAL_INGESTION__PARALLEL_PUBLICATIONS=1
NEXTSIGNAL_INGESTION__MAX_READY_CATALOGS=4
NEXTSIGNAL_DASHBOARD__STATS_REFRESH_MS=60000

# Optional: compose.cloudflare.yaml, after preparing .data/cloudflared/ credentials/config.
# Set UID/GID to the owner of those private files on the deployment host.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.3
CLOUDFLARED_UID=1000
CLOUDFLARED_GID=1000
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPUS=0.5

# Product browsing starts with store-reported available products.
NEXTSIGNAL_DASHBOARD__PRODUCT_AVAILABILITY=available

# Trusted reverse proxy address header used for failed-login protection.
NEXTSIGNAL_AUTH__LOGIN_CLIENT_HEADER=cf-connecting-ip

# Bounded WebMCP category review (never starts automatically)
NEXTSIGNAL_AGENT_REVIEW__DEFAULT_PRODUCTS=50
NEXTSIGNAL_AGENT_REVIEW__DEFAULT_INCLUDE_PREVIOUSLY_SKIPPED=false
NEXTSIGNAL_AGENT_REVIEW__MAX_PRODUCTS=500
NEXTSIGNAL_AGENT_REVIEW__BATCH_SIZE=20
NEXTSIGNAL_AGENT_REVIEW__RESULTS_PAGE_SIZE=10
NEXTSIGNAL_AGENT_REVIEW__REFRESH_MS=3000
NEXTSIGNAL_AGENT_REVIEW__INSTRUCTIONS_FILE=agent-category-review.md

# AI request recovery: retry only confirmed rejections; retain uncertain charges.
NEXTSIGNAL_MATCHING__GATEWAY__RETRY_ATTEMPTS=3
NEXTSIGNAL_MATCHING__GATEWAY__RETRY_DELAY_MS=1000
NEXTSIGNAL_MATCHING__GATEWAY__RETRY_MAX_DELAY_MS=5000
NEXTSIGNAL_MATCHING__GATEWAY__CONSECUTIVE_FAILURE_LIMIT=3

# Automatic Gateway cooldown and single-request recovery probe.
NEXTSIGNAL_MATCHING__GATEWAY__COOLDOWN_INITIAL_SECONDS=60
NEXTSIGNAL_MATCHING__GATEWAY__COOLDOWN_MAX_SECONDS=900
NEXTSIGNAL_MATCHING__GATEWAY__COOLDOWN_PROBE_LEASE_SECONDS=120

# Bounded local maintenance operations; never a grant to run external work.
NEXTSIGNAL_MAINTENANCE__BATCH_SIZE=10000

# Internal Qwen category review; runs only through an explicitly reviewed task.
NEXTSIGNAL_LLM_REVIEW__INSTRUCTIONS_FILE=llm-category-review.md
NEXTSIGNAL_LLM_REVIEW__CATEGORIES_FILE=category-review-definitions.json
NEXTSIGNAL_LLM_REVIEW__MAX_OUTPUT_TOKENS=256
NEXTSIGNAL_LLM_REVIEW__REASONING_ENABLED=false

# Source-supported matching identity profiles and bounded extra interpretation
NEXTSIGNAL_MATCHING__IDENTITY__PROFILES_FILE=matching-identity.json
NEXTSIGNAL_MATCHING__IDENTITY__COUNTERPART_LIMIT=50
NEXTSIGNAL_MATCHING__IDENTITY__COUNTERPARTS_PER_PRODUCT=5

NEXTSIGNAL_BRAND_REVIEW__DEFAULT_GROUPS=50
NEXTSIGNAL_BRAND_REVIEW__MAX_GROUPS=1000
NEXTSIGNAL_BRAND_REVIEW__BATCH_SIZE=10
NEXTSIGNAL_BRAND_REVIEW__EXAMPLES_PER_GROUP=6
NEXTSIGNAL_BRAND_REVIEW__SCAN_PRODUCTS=5000
NEXTSIGNAL_BRAND_REVIEW__REFRESH_BATCH_SIZE=500
NEXTSIGNAL_BRAND_REVIEW__REFRESH_MS=5000
NEXTSIGNAL_BRAND_REVIEW__RESULTS_PAGE_SIZE=10
NEXTSIGNAL_BRAND_REVIEW__INSTRUCTIONS_FILE=brand-review.md
NEXTSIGNAL_BRAND_REVIEW__LANGUAGE_FILE=brand-review-language.json

NEXTSIGNAL_BRAND_REVIEW__DEFAULT_INCLUDE_PREVIOUSLY_SKIPPED=false
